<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- GitHub.Copilot.SDK is referenced as a floating version (*), unchanged from before CPM. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="*" />
    <PackageVersion Include="Katasec.AITools" Version="0.1.8" />
    <PackageVersion Include="Katasec.AnthropicServer" Version="0.1.7" />
    <PackageVersion Include="Katasec.Forge.Client" Version="0.10.1" />
    <PackageVersion Include="Katasec.Forge.Client.Contracts" Version="0.2.1" />
    <PackageVersion Include="Katasec.Forge.Conversations.Contracts" Version="0.12.0" />
    <PackageVersion Include="Katasec.Forge.Hands" Version="0.1.0" />
    <PackageVersion Include="Katasec.OaiServer" Version="0.1.7" />
    <PackageVersion Include="Katasec.OciClient" Version="0.5.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="ModelContextProtocol" Version="1.4.0" />
    <PackageVersion Include="Spectre.Console" Version="0.49.1" />
    <PackageVersion Include="StbTrueTypeSharp" Version="1.26.13" />
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />
    <PackageVersion Include="tryAGI.Anthropic" Version="3.8.3" />
    <!-- Terminal.Extensions pins these exactly ([x]); it keeps the pin via VersionOverride. -->
    <PackageVersion Include="XenoAtom.Terminal" Version="[2.2.0]" />
    <PackageVersion Include="XenoAtom.Terminal.UI" Version="3.10.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI.Extensions.CodeEditor.TextMateSharp" Version="3.10.0" />
    <PackageVersion Include="XenoAtom.Terminal.UI.Extensions.Markdown" Version="3.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageVersion Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>
</Project>
