<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="*" />
    <PackageReference Include="Katasec.AnthropicServer" Version="0.1.7" />
    <PackageReference Include="Katasec.OaiServer" Version="0.1.7" />
    <!-- The event type the forge chat transcript mapping reads (same version forge resolves). -->
    <PackageReference Include="Katasec.Forge.Conversations.Contracts" Version="0.4.0" />
    <!-- Style types the forge chat TUI style tests compare (same versions forge uses). -->
    <PackageReference Include="XenoAtom.Terminal.UI" Version="3.10.0" />
    <PackageReference Include="XenoAtom.Terminal.UI.Extensions.Markdown" Version="3.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ForgeMission.Core\ForgeMission.Core.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.Parser\ForgeMission.Parser.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.Scout\ForgeMission.Scout.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.ChatClients\ForgeMission.ChatClients.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.Serve\ForgeMission.Serve.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.Docker\ForgeMission.Docker.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.MissionRegistry\ForgeMission.MissionRegistry.csproj" />
    <ProjectReference Include="..\..\src\ForgeMission.Cli\ForgeMission.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="Missions/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
