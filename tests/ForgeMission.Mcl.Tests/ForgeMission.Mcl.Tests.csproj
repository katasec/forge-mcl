    <ProjectReference Include="../ForgeMission.Exec.Probe/ForgeMission.Exec.Probe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="Missions/**" CopyToOutputDirectory="PreserveNewest" />
