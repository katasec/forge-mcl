<Project>
  <!--
    Applies to every project under src/ automatically (MSBuild walks up from each project
    looking for this file) — one place to enforce zero-warnings, instead of repeating it in
    22 individual .csproj files. A project with a real, justified suppression (e.g. the
    YamlDotNet AOT warnings in ForgeMission.Cli) still adds its own <NoWarn> in its own
    .csproj — NoWarn wins over TreatWarningsAsErrors, so documented exceptions keep working
    exactly as before.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryUrl>https://github.com/katasec/forge-mcl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Embed debug symbols in the assembly itself instead of emitting a separate loose .pdb —
         keeps crash/stack-trace diagnostics without the desktop app's published output folder
         accumulating one .pdb per referenced library project for no runtime purpose. -->
    <DebugType>embedded</DebugType>
    <ForgeMclParserPackageVersion Condition="'$(ForgeMclParserPackageVersion)' == ''">1.0.0</ForgeMclParserPackageVersion>
    <ForgeMclCorePackageVersion Condition="'$(ForgeMclCorePackageVersion)' == ''">1.0.0</ForgeMclCorePackageVersion>
    <ForgeMclChatClientsPackageVersion Condition="'$(ForgeMclChatClientsPackageVersion)' == ''">1.0.0</ForgeMclChatClientsPackageVersion>
    <ForgeMclScoutPackageVersion Condition="'$(ForgeMclScoutPackageVersion)' == ''">1.0.0</ForgeMclScoutPackageVersion>
    <ForgeMclMissionRegistryPackageVersion Condition="'$(ForgeMclMissionRegistryPackageVersion)' == ''">1.0.0</ForgeMclMissionRegistryPackageVersion>
    <ForgeMclServePackageVersion Condition="'$(ForgeMclServePackageVersion)' == ''">1.0.0</ForgeMclServePackageVersion>
    <ForgeDockerPackageVersion Condition="'$(ForgeDockerPackageVersion)' == ''">0.1.0</ForgeDockerPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
