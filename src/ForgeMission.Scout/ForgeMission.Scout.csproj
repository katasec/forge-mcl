<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scout</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Katasec.Forge.Mcl.Scout</PackageId>
    <Version>$(ForgeMclScoutPackageVersion)</Version>
    <IsPackable>true</IsPackable>
    <!-- AOT-clean by construction (will be referenced by the AOT `forge` CLI eventually):
         no reflection, no bare JsonSerializerOptions — STJ source-gen only (see Grok/GrokWire.cs). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Core\ForgeMission.Core.csproj" TreatAsPackageReference="true" Version="[$(ForgeMclCorePackageVersion)]" />
  </ItemGroup>

</Project>
