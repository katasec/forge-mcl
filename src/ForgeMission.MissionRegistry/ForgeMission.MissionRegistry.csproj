<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Katasec.Forge.Mcl.MissionRegistry</PackageId>
    <Version>0.1.0</Version>
    <Authors>Katasec</Authors>
    <Description>Generic OCI mission and expert retrieval with a local Forge cache and registry credential boundary.</Description>
    <PackageTags>mcl;mission-control-language;oci;registry;mission;expert;aot</PackageTags>
    <PackageProjectUrl>https://github.com/katasec/forge-mcl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/katasec/forge-mcl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="/" Link="LICENSE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Katasec.OciClient" Version="0.2.1" />
  </ItemGroup>
</Project>
