<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Katasec.Forge.Mcl.MissionRegistry</PackageId>
    <Version>$(ForgeMclMissionRegistryPackageVersion)</Version>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Core\ForgeMission.Core.csproj" TreatAsPackageReference="true" Version="[$(ForgeMclCorePackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Katasec.OciClient" Version="0.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltinMissionReferences/vanilla.oci-ref"
                      LogicalName="ForgeMission.MissionRegistry.BuiltinMissionReferences.vanilla.oci-ref" />
  </ItemGroup>

</Project>
